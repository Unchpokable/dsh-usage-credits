{
  "name": "@local/dsh-api-credits",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: API credit balance and cache-aware session spend, converted from CNY to USD and a chosen local currency at live exchange rates.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unchpokable/dsh-usage-credits.git"
  },
  "homepage": "https://github.com/Unchpokable/dsh-usage-credits#readme",
  "bugs": {
    "url": "https://github.com/Unchpokable/dsh-usage-credits/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "credits",
    "balance",
    "tokens",
    "exchange-rate"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
